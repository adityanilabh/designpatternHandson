# Copy this file to `.env.local` and fill in the two values from Supabase.
#
#   Supabase dashboard → your project → Settings → API
#   (newer dashboards call it Settings → API Keys / Data API)
#
# Both of these are PUBLIC by design — they are shipped to every visitor's
# browser. Row Level Security is what protects the data, not secrecy of these.
# `.env.local` is gitignored anyway.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Labelled "anon / public" on older dashboards (a long eyJ... JWT),
# or "Publishable key" on newer ones (sb_publishable_...). Either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# NEVER put the service_role / secret key in this file or anywhere in the repo.
# It bypasses every Row Level Security policy. Nothing in this app needs it —
# if a future server-only task does, it goes in Vercel's env vars alone.
# ---------------------------------------------------------------------------
